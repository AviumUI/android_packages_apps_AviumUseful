android_app {
    name: "AviumUseful",

    srcs: ["src/**/*.java", "src/**/*.kt"],
    resource_dirs: ["src/main/res"],
    manifest: "src/main/AndroidManifest.xml",

    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,
    required: ["privapp_whitelist_org.avium.aviumuseful"],

    static_libs: [
        "kotlin-stdlib",
        "androidx.core_core",
        "androidx.preference_preference",
        "SettingsLib",
    ],

    optimize: {
        optimize: true,
        proguard_flags_files: ["proguard-rules.pro"],
        shrink_resources: true,
    },

}

prebuilt_etc {
    name: "privapp_whitelist_org.avium.aviumuseful",
    system_ext_specific: true,
    sub_dir: "permissions",
    src: "privapp_whitelist_org.avium.aviumuseful.xml",
    filename_from_src: true,
}
