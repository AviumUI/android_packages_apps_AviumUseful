<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/app_name">

    <com.android.settingslib.widget.LayoutPreference
        android:key="header_view"
        android:layout="@layout/settings_header"
        android:selectable="false" />

    <PreferenceCategory android:title="@string/category_function">

        <SwitchPreferenceCompat
            android:key="screen_always_on"
            android:title="@string/switch_screen_always_on_title"
            android:summary="@string/switch_screen_always_on_desc"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="torch_suggestion"
            android:title="@string/switch_torch_suggestion_title"
            android:summary="@string/switch_torch_suggestion_desc"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="sms_code_suggestion"
            android:title="@string/switch_sms_code_title"
            android:summary="@string/switch_sms_code_desc"
            android:defaultValue="false" />

        <com.android.settingslib.PrimarySwitchPreference
            android:key="music_suggestion_switch"
            android:title="@string/switch_music_suggestion_title"
            android:summary="@string/switch_music_suggestion_summary_off"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="url_suggestion"
            android:title="@string/switch_url_suggestion_title"
            android:summary="@string/switch_url_suggestion_desc"
            android:defaultValue="false" />
        
        <SwitchPreferenceCompat
            android:key="url_share_suggestion"
            android:title="@string/switch_url_share_title"
            android:summary="@string/switch_url_share_desc"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="delivery_suggestion"
            android:title="@string/switch_delivery_title"
            android:summary="@string/switch_delivery_desc"
            android:defaultValue="false" />
	
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="privacy_notice"
        android:title="@string/privacy_notice" />
</androidx.preference.PreferenceScreen>
